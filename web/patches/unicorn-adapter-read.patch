+#ifdef __EMSCRIPTEN__
+// Caller guarantees immutable mapping/permissions, identity ARM addresses,
+// no physical aliases, and no valid-memory hooks for the engine lifetime.
+UNICORN_EXPORT void touchHLE_uc_read_region(uc_engine *uc, uint32_t base,
+                                           uint32_t size, void *pointer)
+{
+    // Largest fixed region in each address-space half: low RAM and high stack.
+    // A region crossing the half boundary retains normal MMU handling.
+    unsigned slot = base >> 31;
+    if (size && (((uint64_t)base + size - 1) >> 31) == slot &&
+        size > uc->touchhle_read_size[slot]) {
+        uc->touchhle_read_base[slot] = base;
+        uc->touchhle_read_size[slot] = size;
+        uc->touchhle_read_pointer[slot] = pointer;
+    }
+}
+#endif
 
