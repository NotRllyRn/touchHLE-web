+int touchhle_tb_archive_test_put(unsigned contract, unsigned variant)
+{
+    if (!th_test_seed_valid || !contract || variant > 2)
+        return 0;
+    th_work = th_test_seed;
+    th_work.key.contract = contract;
+    if (variant)
+        th_work.guest[0] ^= 1;
+    if (variant == 2) {
+        if (th_work.code_size > TH_CODE_MAX - 2)
+            return 0;
+        th_work.code[th_work.code_size++] = INDEX_op_mb;
+        th_work.code[th_work.code_size++] = 2;
