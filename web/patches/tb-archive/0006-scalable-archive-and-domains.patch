+unsigned touchhle_tb_archive_test_fill(unsigned first, unsigned count)
+{
+    unsigned i;
+    for (i = 0; i < count; ++i) {
+        if (!touchhle_tb_archive_test_put(first + i, 0))
+            break;
+    }
+    return i;
