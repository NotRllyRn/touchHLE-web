+/* Return 0 absent/corrupt, 1 original, 2 changed guest, 3 larger payload. */
+unsigned touchhle_tb_archive_test_find(unsigned contract)
+{
+    THKey key = th_test_seed.key;
+    uint32_t at;
+    if (!th_test_seed_valid)
+        return 0;
+    key.contract = contract;
+    at = th_store_find(&th_store, &key, NULL);
+    if (at == UINT32_MAX || !th_store_load(at, &th_work))
+        return 0;
+    if (th_work.code_size == th_test_seed.code_size + 2)
+        return 3;
+    return th_work.guest[0] == th_test_seed.guest[0] ? 1 : 2;
