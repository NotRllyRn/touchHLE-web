+/* Bounded exact-runtime record storage. LGPL-2.1-or-later.
+ * This index is rebuilt, never serialized. No ownership pointer is imported. */
+#ifdef TOUCHHLE_TB_RESTORE_TESTS
+static int th_fail_after = -1;
+void touchhle_tb_archive_test_fail_after(int n) { th_fail_after = n; }
+#endif
+static void *th_alloc(uint32_t bytes)
+{
+    void *p;
+#ifdef TOUCHHLE_TB_RESTORE_TESTS
+    if (th_fail_after == 0)
+        return NULL;
+    if (th_fail_after > 0)
+        --th_fail_after;
+#endif
+    if (bytes > 2ULL * TH_MAX_BYTES - th_allocated)
+        return NULL;
+    p = g_try_malloc0(bytes);
+    if (p) {
+        th_allocated += bytes;
+        th_peak = MAX(th_peak, th_allocated);
+    }
+    return p;
+}
+static void th_free(void *p, uint32_t bytes)
+{
+    if (p) {
+        g_free(p);
+        th_allocated -= bytes;
+    }
+}
+static uint32_t th_key_hash(const THKey *k)
+{
+    uint32_t v[] = {k->contract,
+                    k->contract >> 32,
+                    k->features,
+                    k->features >> 32,
+                    k->exit,
+                    k->exit >> 32,
+                    k->pc,
+                    k->cs_base,
+                    k->flags,
+                    k->cflags,
+                    k->trace,
+                    k->model,
+                    k->mode,
+                    k->max_insns,
+                    k->budget_active | (k->budget_adapter << 1) |
+                        (k->no_exit_request << 2)};
+    uint32_t h = 2166136261u;
+    unsigned i;
+    for (i = 0; i < ARRAY_SIZE(v); ++i)
+        h = (h ^ v[i]) * 16777619u;
+    h ^= h >> 16;
+    h *= 0x7feb352du;
+    h ^= h >> 15;
+    h *= 0x846ca68bu;
+    return h ^ (h >> 16);
+}
+static bool th_key_equal(const THKey *a, const THKey *b)
+{
+    return a->contract == b->contract && a->features == b->features &&
+           a->exit == b->exit && a->pc == b->pc && a->cs_base == b->cs_base &&
+           a->flags == b->flags && a->cflags == b->cflags &&
+           a->trace == b->trace && a->model == b->model && a->mode == b->mode &&
+           a->max_insns == b->max_insns &&
+           a->budget_active == b->budget_active &&
+           a->budget_adapter == b->budget_adapter &&
+           a->no_exit_request == b->no_exit_request;
+}
+static uint32_t th_store_find(THStore *store, const THKey *key, uint32_t *slot)
+{
+    uint32_t hash = th_key_hash(key), at, probes;
+    if (!store->index)
+        return UINT32_MAX;
+    at = hash & store->mask;
+    for (probes = 0; probes <= store->mask; ++probes) {
+        uint32_t index = store->index[at];
+        ++store->probes;
+        if (!index) {
+            if (slot)
+                *slot = at;
+            return UINT32_MAX;
+        }
+        THPacked *p = store->entries[index - 1];
+        if (p->hash == hash && th_key_equal(&p->key, key)) {
+            if (slot)
+                *slot = at;
+            return index - 1;
+        }
+        at = (at + 1) & store->mask;
+    }
+    /* With <=50% load and no deletion this is an invariant violation. */
+    g_assert_not_reached();
+}
+static bool th_store_init(THStore *store)
+{
+    uint32_t slots = 2, pointers = th_limit_records * sizeof(*store->entries);
+    uint32_t indices;
+    if (store->index)
+        return true;
+    while (slots < 2 * th_limit_records)
+        slots <<= 1;
+    indices = slots * sizeof(*store->index);
+    if (pointers + indices > th_limit_bytes) {
+        ++store->quota;
+        return false;
+    }
+    store->entries = th_alloc(pointers);
+    store->index = th_alloc(indices);
+    if (!store->entries || !store->index) {
+        th_free(store->entries, pointers);
+        th_free(store->index, indices);
+        store->entries = NULL;
+        store->index = NULL;
+        ++store->oom;
+        return false;
+    }
+    store->mask = slots - 1;
+    store->resident = pointers + indices;
+    return true;
+}
+static void th_store_destroy(THStore *store)
+{
+    uint32_t i;
+    for (i = 0; i < store->count; ++i) {
+        THPacked *p = store->entries[i];
+        th_free(p, sizeof(*p) + p->size);
+    }
+    th_free(store->index, (store->mask + 1) * sizeof(*store->index));
+    th_free(store->entries, th_limit_records * sizeof(*store->entries));
+    memset(store, 0, sizeof(*store));
+}
+int touchhle_tb_archive_limits(uint32_t records, uint32_t bytes)
+{
+    if (!records || records > TH_MAX_RECORDS || !bytes ||
+        bytes > TH_MAX_BYTES || th_store.count)
+        return 0;
+    th_store_destroy(&th_store);
+    th_limit_records = records;
+    th_limit_bytes = bytes;
+    return 1;
+}
+static bool th_store_put(THStore *store, THEntry *e)
+{
+    static uint8_t encoded[TH_RECORD_MAX];
+    THWire w = {.out = encoded, .len = sizeof(encoded), .ok = true};
+    uint32_t index, slot = 0, old_size = 0, allocation;
+    uint64_t seal;
+    THPacked *p, *old = NULL;
+    if (!th_wire_record(&w, e) || !th_store_init(store))
+        return false;
+    seal = th_bytes_seal(encoded, w.pos);
+    index = th_store_find(store, &e->key, &slot);
+    if (index != UINT32_MAX) {
+        old = store->entries[index];
+        old_size = sizeof(*old) + old->size;
+        if (old->size == w.pos && old->seal == seal &&
+            !memcmp(old->bytes, encoded, w.pos)) {
+            ++store->dedup;
+            return true;
+        }
+    } else if (store->count == th_limit_records) {
+        ++store->quota;
+        return false;
+    }
+    allocation = sizeof(*p) + w.pos;
+    if (allocation > th_limit_bytes - (store->resident - old_size)) {
+        ++store->quota;
+        return false;
+    }
+    p = th_alloc(allocation);
+    if (!p) {
+        ++store->oom;
+        return false;
+    }
+    p->key = e->key;
+    p->size = w.pos;
+    p->hash = th_key_hash(&e->key);
+    memcpy(p->bytes, encoded, w.pos);
+    p->seal = seal;
+    store->resident = store->resident - old_size + allocation;
+    store->wire = store->wire - (old ? old->size : 0) + p->size;
+    if (old) {
+        ++store->replaced;
+        th_free(old, old_size);
+    } else {
+        index = store->count++;
+        store->index[slot] = index + 1;
+    }
+    store->entries[index] = p;
+    return true;
+}
+static bool th_store_load(unsigned slot, THEntry *e)
+{
+    THPacked *p;
+    THWire w;
+    if (slot >= th_store.count)
+        return false;
+    p = th_store.entries[slot];
+    if (p->seal != th_bytes_seal(p->bytes, p->size))
+        return false;
+    memset(e, 0, offsetof(THEntry, ptrs));
+    w = (THWire){.in = p->bytes, .len = p->size, .ok = true};
+    return th_wire_record(&w, e) && w.pos == p->size;
+}
