+/* Experimental local-capture persistence codec.
+ * Same LGPL-2.1-or-later terms as translate-all.c.
+ * No native structure, padding, seal, or captured address is serialized.
+ */
+#define TH_ID_MAX 4096
+#define TH_WIRE_MAX                                                            \
+    (28 + TH_ID_MAX +                                                          \
+     TH_ARCHIVE_SLOTS *                                                        \
+         (96 + 8 * TCG_PTR_RELOC_MAX + 4096 + TH_CODE_MAX + TH_SEARCH_MAX))
+
+typedef struct THWire {
+    uint8_t *out;
+    const uint8_t *in;
+    uint32_t pos, len;
+    bool ok;
+} THWire;
+
+/* Subtraction bounds before every addition, including size-only export. */
+static void th_wire_bytes(THWire *w, uint8_t *bytes, uint32_t n)
+{
+    if (!w->ok || w->pos > w->len || n > w->len - w->pos) {
+        w->ok = false;
+        return;
+    }
+    if (w->in) {
+        memcpy(bytes, w->in + w->pos, n);
+    } else if (w->out) {
+        memcpy(w->out + w->pos, bytes, n);
+    }
+    w->pos += n;
+}
+static void th_wire_int(THWire *w, uint64_t *v, unsigned n)
+{
+    uint8_t b[8];
+    unsigned i;
+    for (i = 0; i < n; ++i) {
+        b[i] = *v >> (8 * i);
+    }
+    th_wire_bytes(w, b, n);
+    if (w->in && w->ok) {
+        *v = 0;
+        for (i = 0; i < n; ++i) {
+            *v |= (uint64_t)b[i] << (8 * i);
+        }
+    }
+}
+#define TH_FIELD(field, width)                                                 \
+    do {                                                                       \
+        uint64_t value = (field);                                              \
+        th_wire_int(w, &value, width);                                         \
+        (field) = value;                                                       \
+    } while (0)
+/* Deliberately check before assigning C bool (which normalizes invalid input).
+ */
+static bool th_wire_bool(THWire *w, bool *v)
+{
+    uint64_t value = *v;
+    th_wire_int(w, &value, 1);
+    if (!w->ok || value > 1) {
+        return false;
+    }
+    *v = value;
+    return true;
+}
+static bool th_wire_record(THWire *w, THEntry *e)
+{
+    unsigned i;
+    uint32_t start = w->pos, size = 0;
+    TH_FIELD(size, 4);
+    TH_FIELD(e->key.contract, 8);
+    TH_FIELD(e->key.features, 8);
+    TH_FIELD(e->key.exit, 8);
+    TH_FIELD(e->key.pc, 4);
+    TH_FIELD(e->key.cs_base, 4);
+    TH_FIELD(e->key.flags, 4);
+    TH_FIELD(e->key.cflags, 4);
+    TH_FIELD(e->key.trace, 4);
+    TH_FIELD(e->key.model, 4);
+    TH_FIELD(e->key.mode, 4);
+    TH_FIELD(e->key.max_insns, 4);
+    if (!th_wire_bool(w, &e->key.budget_active) ||
+        !th_wire_bool(w, &e->key.budget_adapter) ||
+        !th_wire_bool(w, &e->key.no_exit_request)) {
+        return false;
+    }
+    TH_FIELD(e->code_size, 4);
+    TH_FIELD(e->search_size, 4);
+    TH_FIELD(e->size, 4);
+    TH_FIELD(e->icount, 4);
+    TH_FIELD(e->ptr_count, 4);
+    for (i = 0; i < 2; ++i) {
+        TH_FIELD(e->reset[i], 2);
+    }
+    for (i = 0; i < 2; ++i) {
+        TH_FIELD(e->jump[i], 4);
+    }
+    if (!th_wire_bool(w, &e->no_exit_after) || !w->ok || !e->key.contract ||
+        !e->key.max_insns || e->size > sizeof(e->guest) ||
+        e->code_size > sizeof(e->code) || e->search_size > sizeof(e->search) ||
+        e->ptr_count > TCG_PTR_RELOC_MAX) {
+        return false;
+    }
+    for (i = 0; i < e->ptr_count; ++i) {
+        TH_FIELD(e->ptrs[i].offset, 4);
+        TH_FIELD(e->ptrs[i].recipe, 4);
+    }
+    th_wire_bytes(w, e->guest, e->size);
+    th_wire_bytes(w, e->code, e->code_size);
+    th_wire_bytes(w, e->search, e->search_size);
+    if (!w->ok) {
+        return false;
+    }
+    if (w->in) {
+        return size == w->pos - start;
+    }
+    if (w->out) {
+        THWire patch = {.out = w->out, .pos = start, .len = w->len, .ok = true};
+        uint64_t length = w->pos - start;
+        th_wire_int(&patch, &length, 4);
+    }
+    return true;
+}
+#undef TH_FIELD
+
+/* Reuse the canonical checker without resolving engine pointers. It only
+ * writes to scratch; canonical goto padding/targets must already be zero. */
+static bool th_canonical(const THEntry *e)
+{
+    th_work = *e;
+    return th_code(&th_work, NULL, NULL, false, true) &&
+           !memcmp(th_work.code, e->code, e->code_size);
+}
+static bool th_wire_header(THWire *w, const uint8_t *identity,
+                           uint32_t identity_len, uint32_t total,
+                           uint32_t *count)
+{
+    uint8_t magic[8] = {'T', 'H', 'T', 'B', 'L', 'E', 0, 0}, got[8];
+    uint64_t version = 1, flags = 0, length = total, entries = *count;
+    uint64_t idlen = identity_len;
+    memcpy(got, magic, 8);
+    th_wire_bytes(w, got, 8);
+    th_wire_int(w, &version, 4);
+    th_wire_int(w, &flags, 4);
+    th_wire_int(w, &length, 4);
+    th_wire_int(w, &entries, 4);
+    th_wire_int(w, &idlen, 4);
+    if (!w->ok || memcmp(got, magic, 8) || version != 1 || flags ||
+        length != total || entries > TH_ARCHIVE_SLOTS ||
+        idlen != identity_len || idlen > w->len - w->pos) {
+        return false;
+    }
+    if (w->in && memcmp(w->in + w->pos, identity, identity_len)) {
+        return false;
+    }
+    /* write path copies only; caller identity is never modified */
+    if (w->out) {
+        memcpy(w->out + w->pos, identity, identity_len);
+    }
+    w->pos += identity_len;
+    *count = entries;
+    return true;
+}
+uint32_t touchhle_tb_archive_export(const uint8_t *identity,
+                                    uint32_t identity_len, uint8_t *output,
+                                    uint32_t capacity)
+{
+    THWire w = {.len = TH_WIRE_MAX, .ok = true};
+    uint32_t i, count = th_used, total;
+    if (!identity || !identity_len || identity_len > TH_ID_MAX) {
+        return 0;
+    }
+    /* Dry run validates every record before writing anything to output. */
+    w.pos = 28 + identity_len;
+    for (i = 0; i < count; ++i) {
+        if (th_entries[i].seal != th_seal(&th_entries[i]) ||
+            !th_canonical(&th_entries[i]) || !th_wire_record(&w, &th_work)) {
+            return 0;
+        }
+    }
+    total = w.pos;
+    if (!output) {
+        return total;
+    }
+    if (capacity < total) {
+        return 0;
+    }
+    w = (THWire){.out = output, .len = total, .ok = true};
+    if (!th_wire_header(&w, identity, identity_len, total, &count)) {
+        return 0;
+    }
+    for (i = 0; i < count; ++i) {
+        th_work = th_entries[i];
+        if (!th_wire_record(&w, &th_work)) {
+            return 0;
+        }
+    }
+    return w.pos == total ? total : 0;
+}
+int touchhle_tb_archive_import(const uint8_t *identity, uint32_t identity_len,
+                               const uint8_t *input, uint32_t length)
+{
+    THEntry *pending;
+    THWire w = {.in = input, .len = length, .ok = true};
+    uint32_t i, j, count = 0;
+    bool ok = false;
+    if (!identity || !identity_len || identity_len > TH_ID_MAX || !input ||
+        length < 28 || length > TH_WIRE_MAX ||
+        !th_wire_header(&w, identity, identity_len, length, &count)) {
+        return 0;
+    }
+    pending = g_try_malloc0(sizeof(th_entries));
+    if (!pending) {
+        return 0;
+    }
+    for (i = 0; i < count; ++i) {
+        if (!th_wire_record(&w, &pending[i]) || !th_canonical(&pending[i])) {
+            goto done;
+        }
+        for (j = 0; j < i; ++j) {
+            if (!memcmp(&pending[i].key, &pending[j].key, sizeof(THKey))) {
+                goto done;
+            }
+        }
+        pending[i].seal = th_seal(&pending[i]);
+    }
+    if (w.pos != length) {
+        goto done;
+    }
+    memcpy(th_entries, pending, sizeof(th_entries));
+    th_used = count;
+    th_next = count % TH_ARCHIVE_SLOTS;
+    ok = true;
+done:
+    g_free(pending);
+    return ok;
+}
