+#ifdef TOUCHHLE_TB_RESTORE_TESTS
+/* In-process fault injection only. Never present in a normal prototype build.
+ * Re-sealing deliberately bypasses the accidental-corruption gate, so these
+ * execution tests reach the semantic search/IT validator itself. */
+static unsigned th_test_max_insns;
+void touchhle_tb_archive_test_limit(unsigned n) { th_test_max_insns = n; }
+void touchhle_tb_archive_test_no_exit(struct uc_struct *uc, bool value)
+{
+    uc->no_exit_request = value;
+}
+int touchhle_tb_archive_test_search(unsigned kind)
+{
+    THEntry *e;
+    const uint8_t *p;
+    int32_t d;
+    unsigned j;
+    if (!th_used || kind > 4) {
+        return 0;
+    }
+    e = &th_entries[0];
+    if (!th_search(e) || e->search[0] != 0) {
+        return 0;
+    }
+    p = e->search;
+    for (j = 0; j < 3; ++j) {
+        if (!th_sleb(&p, e->search + e->search_size, &d)) {
+            return 0;
+        }
+    }
+    switch (kind) {
+    case 0:
+        e->search[0] = 2;
+        break; /* Aligned, wrong first guest PC. */
+    case 1:
+        e->search[1] ^= 1;
+        break; /* Incorrect initial IT state. */
+    case 2:
+        e->no_exit_after = !e->no_exit_after;
+        break;
+    case 3:
+        e->search[p - e->search] = 0x7f;
+        break; /* Negative host offset. */
+    case 4:
+        e->size -= 2;
+        break; /* Truncated mixed-width guest span. */
+    }
+    e->seal = th_seal(e);
+    return !th_search(e);
+}
+#endif
