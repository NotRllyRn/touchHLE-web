+uintptr_t tcg_qemu_tb_exec(CPUArchState *env, uint8_t *tb_ptr)
+{
+    tcg_target_ulong regs[TCG_TARGET_NB_REGS] = {0};
+    long tcg_temps[CPU_TEMP_BUF_NLONGS];
