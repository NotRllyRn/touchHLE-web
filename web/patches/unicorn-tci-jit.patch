+    if (!configured) {
+        static const uint32_t read_layout[] = {
+            offsetof(CPUArchState, uc), offsetof(struct uc_struct, touchhle_read_base),
+            offsetof(struct uc_struct, touchhle_read_size), offsetof(struct uc_struct, touchhle_read_pointer),
+            offsetof(struct uc_struct, touchhle_code_pages),
+            (uintptr_t)glue(adapter_helper_, check_exit_request),
+            offsetof(ArchCPU, neg.icount_decr.u32) - offsetof(ArchCPU, env)
+        };
+        enabled = touchhle_tci_init((uintptr_t)&touchhle_compiled_executions,
+            (uintptr_t)touchhle_tci_step, (uintptr_t)read_layout);
+        for (unsigned i = 0; i < NB_OPS; ++i)
+            touchhle_tci_opcode(i, env->uc->tcg_ctx->tcg_op_defs[i].name);
+        configured = true;
+    }
+#endif
+    while (tb_ptr) {
+#ifdef __EMSCRIPTEN__
+        typedef uintptr_t (*Compiled)(CPUArchState *, tcg_target_ulong *, uintptr_t, uintptr_t *);
+        if (enabled) {
+            TouchhleDispatch *entry = &touchhle_dispatch[((uintptr_t)tb_ptr >> 4) & 8191];
